{
	"name": "LangGraph AI Agent Dev",
	"image": "mcr.microsoft.com/devcontainers/python:3-3.13-trixie",
	
	// 1. Safe host network fallback check
	"initializeCommand": "docker network inspect agent-net >/dev/null 2>&1 || docker network create agent-net",
	"runArgs": ["--network", "agent-net"],

	"remoteEnv": {
		"HOST_PROJECT_PATH": "${localWorkspaceFolder}"
	},
	
	// 2. Standard user prevents all permission bugs
	"remoteUser": "Yas",

	"features": {
		// Crucial: This feature actually builds the Linux user account 'Yas' safely
		"ghcr.io/devcontainers/features/common-utils:2": {
			"username": "Yas",
			"uid": "1000",
			"gid": "1000",
			"upgradePackages": false
		},
		// Clean, automated DoD handling (No manual volume mounts required)
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"moby": false,
			"enableNonRootDocker": "true",
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.languageServer": "Pylance",
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff",
					"editor.formatOnSave": true,
					"editor.codeActionsOnSave": {
						"source.organizeImports": "always"
					}
				}
			},
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.debugpy",
				"charliermarsh.ruff", // Super fast Rust-based formatter & linter
				"tamasfe.even-better-toml",
				"redhat.vscode-yaml",
				"streetsidesoftware.code-spell-checker"
			]
		}
	},

	// 3. Guaranteed clean global package installations
	"postCreateCommand": "bash .devcontainer/setup.sh"
}
